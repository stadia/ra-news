<% content_for :title, "RA || 루비 AI 뉴스" %>

<div class="flex flex-col lg:flex-row gap-6">
  <!-- Main Content - Articles -->
  <div class="flex-1 min-w-0">
    <div
      id="articlesList"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      <% @articles.each do |article| %>
        <%= render(ArticleComponent.new(article: article)) %>
      <% end %>
    </div>
  </div>
  <!-- Sidebar - Recent Comments -->
  <div class="w-full lg:w-72 shrink-0 order-last lg:order-0">
    <%= render(RecentCommentsSidebarComponent.new(recent_comments: @recent_comments)) %>
  </div>
</div>
