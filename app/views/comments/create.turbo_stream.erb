<% if @comment.persisted? %>
  <%= turbo_stream.replace "comments" do %>
    <%= render(CommentsComponent.new(article: @article, comments: @comments)) %>
  <% end %>
  <%= turbo_stream.update "comments_header" do %>
    <%= render(CommentHeaderComponent.new(comments: @comments)) %>
  <% end %>
  <%= turbo_stream.update "comment_form" do %>
    <%= render(CommentFormComponent.new(article: @article, comment: @comment)) %>
  <% end %>
<% else %>
  <% if @comment.parent_id.present? && @comment.parent.present? %>
    <%= turbo_stream.replace "reply_form_#{@comment.parent_id}" do %>
      <%= render(CommentReplyFormComponent.new(article: @article, comment: @comment, parent_comment: @comment.parent, visible: true)) %>
    <% end %>
  <% else %>
    <%= turbo_stream.update "comment_form" do %>
      <%= render(CommentFormComponent.new(article: @article, comment: @comment)) %>
    <% end %>
  <% end %>
<% end %>
