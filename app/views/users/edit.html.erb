<% content_for :title, "사용자 정보 수정" %>

<div class="max-w-2xl mx-auto py-12 px-4 sm:px-6">
  <% if notice.present? %>
    <div
      class="
        mb-8 flex items-center gap-3 py-3 px-4 bg-green-500/10 text-green-400
        font-medium rounded-xl border border-green-500/20 shadow-sm
      "
      id="notice"
    >
      <%= phlex_icon "check-circle", variant: :outline, class: "w-5 h-5" %>
      <%= notice %>
    </div>
  <% end %>

  <div
    class="
      flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-2 px-1
    "
  >
    <div>
      <%= render RubyUI::Heading.new(
        level: 1,
        class: "text-3xl font-bold text-white tracking-tight",
      ) { "사용자 정보 수정" } %>
      <p class="mt-1 text-slate-400">계정 정보를 업데이트합니다.</p>
    </div>

    <%= render RubyUI::Link.new(
      href: users_path,
      class: "flex items-center justify-center gap-2 py-2 px-5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-100 font-bold text-sm border border-slate-700 transition-all active:scale-95 shadow-lg shadow-black/20"
    ) do %>
      <%= phlex_icon "chevron-left", variant: :outline, class: "w-4 h-4" %>
      돌아가기
    <% end %>
  </div>

  <%= render Components::Users::Form.new(user: @user) %>
</div>
