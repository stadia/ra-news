<% content_for :title, "RA || 루비 AI 뉴스 - 지난 글들" %>
<!-- 페이지 헤더 -->
<div class="text-center mb-8 lg:mb-12">
  <%= render RubyUI::Heading.new(level: 1, class: "font-bold text-white mb-4") {
    "그 밖의 뉴스"
  } %>
  <p class="text-lg text-gray-300 max-w-2xl mx-auto">
    <%= @pagy.count %>개의 글이 있습니다
    <% if params[:search].present? %><%= params[:search] %><% end %>
  </p>
</div>
<!-- 아티클 목록 -->
<div id="articlesList" class="space-y-6 lg:space-y-8 max-w-6xl mx-auto">
  <% @articles.each do |article| %>
    <%= render(Components::Articles::Article.new(article: article)) %>
  <% end %>
  <!-- 페이지네이션 -->
  <% if @pagy.pages > 1 %>
    <div class="pagy mt-auto">
      <div class="bg-gray-800 rounded-xl p-2 md:p-3 border border-gray-700">
        <%== @pagy.series_nav %>
      </div>
    </div>
  <% end %>
</div>
