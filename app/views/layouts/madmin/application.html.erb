<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="ROBOTS" content="NOODP">
    <meta name="viewport" content="initial-scale=1">
    <title>
      <% if content_for? :title %>
        <%= yield(:title) %>
        -
      <% end %>
      <%= Madmin.site_name %>
      Admin
    </title>
    <%= csrf_meta_tags %>
    <%= render "javascript" %>
  </head>
  <body
    class="
      <%= controller_name %> <%= action_name %>
    "
    data-controller="mobile-nav"
  >
    <header>
      <%= render "flash" %>
    </header>
    <header id="navbar">
      <div class="nav-group">
        <button
          id="hamburger-menu"
          type="button"
          data-action="click->mobile-nav#toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <%= phlex_icon "bars-3", variant: :mini, class: "size-5" %>
        </button>
        <%= link_to Madmin.site_name,
        try(:root_url) || madmin_root_url,
        data: {
          turbo: false,
        } %>
      </div>
    </header>

    <main>
      <aside id="sidebar" data-mobile-nav-target="menu">
        <%= render "navigation" %>
      </aside>

      <div>
        <%= yield %>
      </div>
    </main>

    <div
      data-mobile-nav-target="overlay"
      data-action="click->mobile-nav#close"
      class="mobile-nav-overlay"
    ></div>
  </body>
</html>
