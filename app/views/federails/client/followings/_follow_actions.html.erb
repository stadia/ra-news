<%
  current = Current.user
  policy = Federails::Client::FollowingPolicy.new(current, Federails::Following)
%>
<div class="flex flex-wrap items-center gap-3 mt-2">
  <% if policy.create? %>
    <% follow = current.federails_actor.follows?(actor) %>
    <% if actor.entity == current %>
      <span class="text-slate-400 text-sm">내 계정입니다.</span>
    <% elsif follow %>
      <span class="text-slate-400 text-sm">팔로우 중 (<%= follow.status %>)</span>
      <%= button_to "팔로우 취소",
          federails.client_following_path(follow),
          method: :delete,
          class: "px-4 py-2 text-sm font-medium bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg border border-slate-600 transition-colors cursor-pointer" %>
    <% else %>
      <%= button_to "Follow @#{actor.username}",
          federails.follow_client_followings_path,
          params: { account: actor.at_address },
          method: :post,
          class: "px-4 py-2 text-sm font-medium bg-green-600 hover:bg-green-500 text-white rounded-lg transition-colors cursor-pointer" %>
    <% end %>

    <% followed = actor.follows?(current.federails_actor) %>
    <% if followed %>
      <% if followed.pending? %>
        <span class="text-slate-400 text-sm"><%= actor.username %>이(가) 팔로우 요청했습니다.</span>
        <%= button_to "수락",
            federails.accept_client_following_path(followed),
            method: :put,
            class: "px-4 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors cursor-pointer" %>
      <% else %>
        <span class="text-slate-400 text-sm"><%= actor.username %>이(가) 팔로우 중입니다.</span>
      <% end %>
    <% end %>
  <% elsif current.nil? %>
    <p class="text-slate-400 text-sm">
      팔로우하려면 로그인하세요. 또는 다른 Fediverse 서버에서 검색:
      <code class="ml-1 bg-slate-800 px-1.5 py-0.5 rounded text-slate-300 text-xs"><%= actor.at_address(prefix: '') %></code>
    </p>
  <% end %>
</div>
