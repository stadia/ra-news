<%= helpers.turbo_frame_tag "reply_form_#{@parent_comment.id}",
      class: frame_classes,
      data: { reply_form_target: "form" } do %>
  <div
    class="p-4 lg:p-5"
    data-controller="character-count guest-name"
    data-character-count-max-length-value="<%= Comment::MAX_BODY_LENGTH %>"
  >
    <h5
      class="
        text-xs font-semibold text-gray-400 mb-3 flex items-center uppercase
        tracking-wide
      "
    >
      <%= helpers.heroicon "arrow-uturn-left",
                       variant: :outline,
                       options: {
                         class: "w-3 h-3 mr-1.5 text-blue-400",
                       } %>
      답글 작성
    </h5>

    <%= helpers.form_with(
          model: [@article, @comment],
          url: helpers.article_comments_path(@article.slug),
          local: false,
          class: "space-y-3",
          data: { action: "turbo:submit-end->reply-form#close" }
        ) do |f| %>
      <%= f.hidden_field :parent_id, value: @parent_comment.id %>

      <% if @comment.errors.any? %>
        <div
          class="
            bg-red-900 bg-opacity-50 border border-red-500 text-red-200 px-4 py-3 rounded-lg
          "
        >
          <div class="flex items-center mb-2">
            <%= helpers.heroicon "exclamation-circle",
                             variant: :mini,
                             options: {
                               class: "w-5 h-5 mr-2",
                             } %>
            <h5 class="font-medium">오류가 발생했습니다:</h5>
          </div>
          <ul class="list-disc list-inside space-y-1 text-sm">
            <% @comment.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% unless helpers.authenticated? %>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="space-y-2">
            <%= f.label :guest_name, "이름 (필수)", class: "block text-xs font-medium text-gray-400" %>
            <%= f.text_field :guest_name,
                         class: [
                           "w-full px-3 py-2 rounded-lg border bg-gray-700 text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm",
                           (
                             if @comment.errors[:guest_name].none?
                               "border-gray-600 hover:border-gray-500"
                             else
                               "border-red-500 focus:ring-red-500"
                             end
                           ),
                         ].join(" "),
                         placeholder: "이름을 입력하세요",
                         data: {
                           guest_name_target: "input",
                           action: "change->guest-name#save",
                         } %>
          </div>

          <div class="space-y-2">
            <%= f.label :guest_password,
                    "비밀번호 (필수)",
                    class: "block text-xs font-medium text-gray-400" %>
            <%= f.password_field :guest_password,
                             class: [
                               "w-full px-3 py-2 rounded-lg border bg-gray-700 text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-sm",
                               (
                                 if @comment.errors[:guest_password].none?
                                   "border-gray-600 hover:border-gray-500"
                                 else
                                   "border-red-500 focus:ring-red-500"
                                 end
                               ),
                             ].join(" "),
                             placeholder: "최소 4자 이상" %>
          </div>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.text_area :body,
                    rows: 3,
                    class: [
                      "w-full px-4 py-2 rounded-lg border bg-gray-700 text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 resize-none text-sm",
                      (
                        if @comment.errors[:body].none?
                          "border-gray-600 hover:border-gray-500"
                        else
                          "border-red-500 focus:ring-red-500"
                        end
                      ),
                    ].join(" "),
                    placeholder: "답글을 입력하세요...",
                    maxlength: Comment::MAX_BODY_LENGTH,
                    data: {
                      character_count_target: "input",
                      action: "input->character-count#updateCount",
                    } %>
        <div class="text-xs text-gray-500 text-right">
          <span data-character-count-target="counter">0</span>/<%= Comment::MAX_BODY_LENGTH %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2">
        <button
          type="button"
          class="
            px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-gray-200
            transition-colors
          "
          data-action="reply-form#toggle"
        >
          취소
        </button>

        <%= f.submit "답글 작성",
                 class:
                   "inline-flex items-center px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded-md transition-colors duration-200" %>
      </div>
    <% end %>
  </div>
<% end %>
