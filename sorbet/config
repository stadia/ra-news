--dir
.
--disable-watchman
--ignore=tmp/
--ignore=vendor/
--ignore=bin/
# Only loaded by `bin/ci`, which supplies the `CI` constant itself.
--ignore=config/ci.rb
# "Generated by the protocol buffer compiler. DO NOT EDIT!"
--ignore=lib/protobuf/
# Config for the rbs_rails rake tasks, which supply the RbsRails constant.
# The gem is not currently in the Gemfile, but sig/rbs_rails/ is still checked
# in and consumed by Steep, so the file is kept rather than deleted.
--ignore=.rbs_rails.rb
--parser=prism
--enable-experimental-rbs-comments
