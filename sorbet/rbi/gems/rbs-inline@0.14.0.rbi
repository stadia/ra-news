# Type/method type source
#
# pkg:gem/rbs-inline#lib/rbs/inline/annotation_parser/tokenizer.rb:54
RBS::Inline::AnnotationParser::Tokens::T_SOURCE = T.let(T.unsafe(nil), Symbol)

# pkg:gem/rbs-inline#lib/rbs/inline/annotation_parser/tokenizer.rb:46
RBS::Inline::AnnotationParser::Tokens::T_UIDENT = T.let(T.unsafe(nil), Symbol)

# pkg:gem/rbs-inline#lib/rbs/inline/annotation_parser/tokenizer.rb:64
RBS::Inline::AnnotationParser::Tokens::T_WHITESPACE = T.let(T.unsafe(nil), Symbol)

# pkg:gem/rbs-inline#lib/rbs/inline/node_utils.rb:5
module RBS::Inline::NodeUtils
  # @rbs node: Prism::Node
  # @rbs return: TypeName?
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/node_utils.rb:8
  def type_name(node); end
end

# pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:7
class RBS::Inline::Parser < ::Prism::Visitor
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:43
  def initialize; end

  # Fetch Application annotation which is associated to `node`
  #
  # The application annotation is removed from `comments`.
  #
  # @rbs node: Node
  # @rbs return: AST::Annotations::Application?
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:405
  def application_annotation(node); end

  # Fetch TypeAssertion annotation which is associated to `node`
  #
  # The assertion annotation is removed from `comments`.
  #
  # @rbs node: Node | Location
  # @rbs return: AST::Annotations::TypeAssertion?
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:424
  def assertion_annotation(node); end

  # ParsingResult associated with the line number at the end
  #
  # ```rb
  # # Hello
  # # world       <= The comments hash includes `2` (line 2) to the two lines
  # ```
  #
  # > [!IMPORTANT]
  # > The values will be removed during parsing.
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:31
  def comments; end

  # @rbs return: with_members?
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:121
  def current_class_module_decl; end

  # @rbs return: with_members
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:126
  def current_class_module_decl!; end

  # The current module_function applied to single `def` node
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:41
  def current_module_function; end

  # The current visibility applied to single `def` node
  #
  # Assuming it's directly inside `private` or `public` calls.
  # `nil` when the `def` node is not inside `private` or `public` calls.
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:38
  def current_visibility; end

  # The top level declarations
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:15
  def decls; end

  # @rbs node: Node
  # @rbs return: bool
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:391
  def ignored_node?(node); end

  # Returns an array of annotations from comments that is located between start_line and end_line
  #
  # ```rb
  # module Foo        # line 1 (start_line)
  #   # foo
  #   # bar
  # end               # line 4 (end_line)
  # ```
  #
  # @rbs start_line: Integer
  # @rbs end_line: Integer
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:236
  def inner_annotations(start_line, end_line); end

  # Load inner declarations and delete them from `#comments` hash
  #
  # It also sorts the `members` by `#start_line`` ascending.
  #
  # @rbs start_line: Integer
  # @rbs end_line: Integer
  # @rbs members: Array[AST::Members::t | AST::Declarations::t] --
  #   The destination.
  #   The method doesn't insert declarations, but have it to please type checker.
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:157
  def load_inner_annotations(start_line, end_line, members); end

  # @rbs [A] (Node) { () -> A } -> A?
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:380
  def process_nesting_node(node); end

  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:131
  def push_class_module_decl(decl); end

  # @rbs new_visibility: RBS::AST::Members::visibility?
  # @rbs &block: () -> void
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:368
  def push_visibility(new_visibility, &block); end

  # The surrounding declarations
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:19
  def surrounding_decls; end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:265
  def visit_alias_method_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:488
  def visit_block_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:277
  def visit_call_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:175
  def visit_class_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:443
  def visit_constant_write_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:248
  def visit_def_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:210
  def visit_module_node(node); end

  # @rbs override
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:196
  def visit_singleton_class_node(node); end

  class << self
    # Parses the given Prism result to a three tuple
    #
    # Returns a three tuple of:
    #
    # 1. An array of `use` directives
    # 2. An array of declarations
    # 3. An array of RBS declarations given as `@rbs!` annotation at top-level
    #
    # Note that only RBS declarations are allowed in the top-level `@rbs!` annotations.
    # RBS *members* are ignored in the array.
    #
    # @rbs result: ParseResult
    # @rbs opt_in: bool -- `true` for *opt-out* mode, `false` for *opt-in* mode.
    # @rbs return: [Array[AST::Annotations::Use], Array[AST::Declarations::t], Array[RBS::AST::Declarations::t]]?
    #
    # pkg:gem/rbs-inline#lib/rbs/inline/parser.rb:64
    def parse(result, opt_in:); end
  end
end

# pkg:gem/rbs-inline#lib/rbs/inline/version.rb:5
RBS::Inline::VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:7
class RBS::Inline::Writer
  # @rbs buffer: String
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:21
  def initialize(buffer = T.unsafe(nil)); end

  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:18
  def default_type; end

  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:18
  def default_type=(_arg0); end

  # @rbs *lines: String
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:40
  def header(*lines); end

  # @rbs!
  #   interface _Content
  #     def <<: (RBS::AST::Declarations::t | RBS::AST::Members::t) -> void
  #
  #     def concat: (Array[RBS::AST::Declarations::t | RBS::AST::Members::t]) -> void
  #   end
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:15
  def output; end

  # @rbs decl: AST::Declarations::ClassDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:106
  def translate_class_decl(decl, rbs); end

  # @rbs decl: AST::Declarations::ConstantDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:181
  def translate_constant_decl(decl, rbs); end

  # @rbs decl: AST::Declarations::DataAssignDecl
  # @rbs rbs: _Content
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:199
  def translate_data_assign_decl(decl, rbs); end

  # @rbs decl: AST::Declarations::t
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:79
  def translate_decl(decl, rbs); end

  # @rbs member: AST::Members::t
  # @rbs decl: AST::Declarations::SingletonClassDecl? --
  #   The surrouding singleton class definition
  # @rbs rbs: _Content
  # @rbs return void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:467
  def translate_member(member, decl, rbs); end

  # @rbs members: Array[AST::Declarations::t | AST::Members::t]
  # @rbs decl: AST::Declarations::SingletonClassDecl?
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:132
  def translate_members(members, decl, rbs); end

  # @rbs decl: AST::Declarations::ModuleDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:154
  def translate_module_decl(decl, rbs); end

  # @rbs decl: AST::Declarations::SingletonClassDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:454
  def translate_singleton_decl(decl, rbs); end

  # @rbs decl: AST::Declarations::StructAssignDecl
  # @rbs rbs: _Content
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:315
  def translate_struct_assign_decl(decl, rbs); end

  # @rbs uses: Array[AST::Annotations::Use]
  # @rbs decls: Array[AST::Declarations::t]
  # @rbs rbs_decls: Array[RBS::AST::Declarations::t] --
  #    Top level `rbs!` declarations
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:52
  def write(uses, decls, rbs_decls); end

  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:16
  def writer; end

  private

  # @rbs decl: AST::Declarations::ConstantDecl
  # @rbs return: RBS::Types::t
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:629
  def constant_decl_to_type(decl); end

  # Returns the `kind` of the method definition
  #
  # ```rb
  # def self.foo = ()    # :singleton
  # class A
  #   class << self
  #     def bar = ()     # :singleton
  #   end
  # end
  #
  # def object.foo = ()  # Not supported (returns :instance)
  # ```
  #
  # @rbs member: AST::Members::RubyDef
  # @rbs decl: AST::Declarations::SingletonClassDecl?
  # @rbs return: RBS::AST::Members::MethodDefinition::kind
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:557
  def method_kind(member, decl); end

  # @rbs block: AST::Declarations::BlockDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:602
  def translate_class_block_decl(block, rbs); end

  # @rbs block: AST::Declarations::BlockDecl
  # @rbs rbs: _Content
  # @rbs return: void
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:572
  def translate_module_block_decl(block, rbs); end

  class << self
    # @rbs uses: Array[AST::Annotations::Use]
    # @rbs decls: Array[AST::Declarations::t]
    # @rbs rbs_decls: Array[RBS::AST::Declarations::t]
    # @rbs &: ? (Writer) -> void
    #
    # pkg:gem/rbs-inline#lib/rbs/inline/writer.rb:31
    def write(uses, decls, rbs_decls, &_arg3); end
  end
end
