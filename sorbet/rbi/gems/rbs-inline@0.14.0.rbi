  # Parses use clause
  #
  # Returns one of the following form:
  #
  # * [`::`?, [UIDENT, `::`]*, LIDENT, [`as` LIDENT]?]
  # * [`::`?, [UIDENT, `::`]*, UIDENT, [`as` UIDENT]?]
  # * [`::`?, [UIDENT, `::`]*, IFIDENT, [`as`, IFIDENT]?]
  # * [`::`?, [UIDENT) `::`]*, `*`]
  #
  # @rbs tokenizer: Tokenizer
  # @rbs return: AST::Tree
  #
  # pkg:gem/rbs-inline#lib/rbs/inline/annotation_parser.rb:703
