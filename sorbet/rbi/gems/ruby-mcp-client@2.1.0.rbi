  def expired?; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/auth.rb:15
  def expires_at; end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/auth.rb:15
  def expires_in; end

  # Check if the token is close to expiring (within 5 minutes)
