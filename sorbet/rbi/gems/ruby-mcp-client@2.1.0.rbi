  def initialize(access_token:, token_type: T.unsafe(nil), expires_in: T.unsafe(nil), scope: T.unsafe(nil), refresh_token: T.unsafe(nil)); end

  # pkg:gem/ruby-mcp-client#lib/mcp_client/auth.rb:15
