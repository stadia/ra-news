  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/batches.rb:61
  def build_jsonl(requests); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/batches.rb:39
  def cancel_batch_url(batch_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/batches.rb:43
