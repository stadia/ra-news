# WebSocket transport for the OpenAI Responses API.
# Provides lower-latency agentic workflows by maintaining a persistent
# wss:// connection instead of HTTP requests per turn.
#
# Requires the `websocket-client-simple` gem (soft dependency).
#
# Integrated usage (recommended):
#   chat = RubyLLM.chat(model: 'gpt-4o', provider: :openai_responses)
#   chat.with_params(transport: :websocket)
#   chat.ask("Hello!")
#
# Standalone usage (advanced):
#   ws = RubyLLM::ResponsesAPI::WebSocket.new(api_key: ENV['OPENAI_API_KEY'])
#   ws.connect
#   ws.create_response(model: 'gpt-4o', input: [...]) { |chunk| ... }
#   ws.disconnect
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:24
class RubyLLM::Providers::OpenAIResponses::WebSocket
  # @param api_key [String] OpenAI API key
  # @param api_base [String] API base URL (https scheme; converted to wss)
  # @param organization_id [String, nil] OpenAI organization ID
  # @param project_id [String, nil] OpenAI project ID
  # @param client_class [#connect, nil] WebSocket client class (for testing)
  # @param response_timeout [Numeric] seconds to wait for a response event
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:38
  def initialize(api_key:, api_base: T.unsafe(nil), organization_id: T.unsafe(nil), project_id: T.unsafe(nil), client_class: T.unsafe(nil), response_timeout: T.unsafe(nil)); end

  # Send a pre-built payload over WebSocket, streaming chunks via block.
  # This is the integration point for Provider#complete -- it accepts the
  # same payload hash that render_payload returns.
  #
  # @param payload [Hash] Responses API payload (model, input, tools, etc.)
  # @yield [RubyLLM::Chunk] each streamed chunk
  # @return [RubyLLM::Message] the assembled final message
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:99
  def call(payload, &_arg1); end

  # Open the WebSocket connection. Blocks until the connection is established.
  # @param timeout [Numeric] seconds to wait for the connection (default: 10)
  # @raise [ConnectionError] if the connection cannot be established
  # @return [self]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:60
  def connect(timeout: T.unsafe(nil)); end

  # @return [Boolean]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:178
  def connected?; end

  # Send a response.create request using raw Responses API format.
  # Useful for standalone usage outside the RubyLLM chat interface.
  #
  # @param model [String] model ID
  # @param input [Array<Hash>] input items in Responses API format
  # @param tools [Array<Hash>, nil] tool definitions
  # @param previous_response_id [String, nil] chain to a prior response
  # @param instructions [String, nil] system/developer instructions
  # @param extra [Hash] additional fields forwarded to the API
  # @yield [RubyLLM::Chunk] each streamed chunk
  # @return [RubyLLM::Message] the assembled final message
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:125
  def create_response(model:, input:, tools: T.unsafe(nil), previous_response_id: T.unsafe(nil), instructions: T.unsafe(nil), **extra, &block); end

  # Disconnect the WebSocket.
  # @return [void]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:172
  def disconnect; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:29
  def last_response_id; end

  # Close and reopen the connection.
  # @return [self]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:184
  def reconnect(timeout: T.unsafe(nil)); end

  # Warm up the connection by sending a response.create with generate: false.
  # Caches model weights server-side without generating output.
  # @param model [String] model ID
  # @param extra [Hash] additional fields
  # @return [void]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:140
  def warmup(model:, **extra); end

  private

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:250
  def accumulate_response(queue, &block); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:293
  def acquire_flight!; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:223
  def build_headers; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:232
  def build_standalone_payload(model:, input:, tools: T.unsafe(nil), previous_response_id: T.unsafe(nil), instructions: T.unsafe(nil), **extra); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:217
  def build_ws_url; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:289
  def ensure_connected!; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:196
  def handle_close; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:203
  def handle_message(data); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:311
  def pop_response_event(queue); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:305
  def pop_with_timeout(queue, seconds); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:301
  def release_flight!; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:208
  def resolve_client_class; end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:246
  def send_json(payload); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/web_socket.rb:284
  def track_response_id(data); end
end

