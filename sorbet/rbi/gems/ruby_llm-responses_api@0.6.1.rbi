# Server-side compaction support for long-running agent sessions.
# Automatically compacts conversation context when token count exceeds threshold.
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:8
module RubyLLM::Providers::OpenAIResponses::Compaction
  private

  # Apply compaction settings to payload
  # @param payload [Hash] The request payload
  # @param params [Hash] Additional parameters that may contain compaction options
  # @return [Hash] Updated payload with context_management
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:26
  def apply_compaction(payload, params); end

  # URL for explicit Responses API compaction.
  # @return [String] The URL path
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:40
  def compact_url; end

  # Build context_management parameter for compaction
  # @param compact_threshold [Integer] Token count threshold to trigger compaction (minimum 1000)
  # @return [Hash] Parameters to merge into request payload via with_params
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:14
  def compaction_params(compact_threshold: T.unsafe(nil)); end

  # URL for Responses API input token counting.
  # @return [String] The URL path
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:46
  def input_tokens_url; end

  class << self
    # Apply compaction settings to payload
    # @param payload [Hash] The request payload
    # @param params [Hash] Additional parameters that may contain compaction options
    # @return [Hash] Updated payload with context_management
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:26
    def apply_compaction(payload, params); end

    # URL for explicit Responses API compaction.
    # @return [String] The URL path
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:40
    def compact_url; end

    # Build context_management parameter for compaction
    # @param compact_threshold [Integer] Token count threshold to trigger compaction (minimum 1000)
    # @return [Hash] Parameters to merge into request payload via with_params
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:14
    def compaction_params(compact_threshold: T.unsafe(nil)); end

    # URL for Responses API input token counting.
    # @return [String] The URL path
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/compaction.rb:46
    def input_tokens_url; end
  end
end

# Containers API support for managing persistent execution environments.
# Containers can be used with the shell tool and code interpreter.
