# Server-executed built-in tool output item types and their argument
# extractors. The key is the output `type` from the Responses API; the
# value is a lambda that pulls the relevant arguments out of that item.
# To support a new built-in tool, add an entry here.
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:200
RubyLLM::Providers::OpenAIResponses::BuiltInTools::CALL_ARGUMENT_EXTRACTORS = T.let(T.unsafe(nil), Hash)

# Model capabilities for OpenAI Responses API models.
# Defines which models support which features.
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:8
module RubyLLM::Providers::OpenAIResponses::Capabilities
  private

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:207
  def capabilities_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:166
  def context_window_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:248
  def find_capability(model_id, mapping); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:233
  def format_display_name(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:174
  def input_price_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:170
  def max_tokens_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:197
  def modalities_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:216
  def model_family(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:259
  def model_matches?(model_id, model_list); end

  # Temperature is not supported for reasoning models
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:242
  def normalize_temperature(temperature, model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:179
  def output_price_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:184
  def pricing_for(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:162
  def reasoning_model?(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:154
  def supports_code_interpreter?(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:142
  def supports_functions?(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:134
  def supports_responses_api?(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:146
  def supports_structured_output?(model_id); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/capabilities.rb:158
  def supports_tool_parallel_control?(_model_id); end

