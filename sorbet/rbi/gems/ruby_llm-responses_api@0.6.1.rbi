# Built-in tools support for the OpenAI Responses API.
# Provides configuration helpers and result parsing for:
# - Web Search
# - File Search
# - Code Interpreter
# - Image Generation
# - MCP (Model Context Protocol)
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:13
module RubyLLM::Providers::OpenAIResponses::BuiltInTools
