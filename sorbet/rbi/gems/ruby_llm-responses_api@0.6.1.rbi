# Chat completion methods for the OpenAI Responses API.
# Handles converting RubyLLM messages to Responses API format and parsing responses.
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:8
module RubyLLM::Providers::OpenAIResponses::Chat
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:9
  def completion_url; end

  private

  # Apply tools and tool preferences to the payload.
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:43
  def apply_tools(payload, tools, tool_prefs); end

  # Build the Responses API text format block from a schema.
  # Schema arrives pre-normalized as { name:, schema:, strict: } from
  # RubyLLM::Chat.with_schema (v1.13+), or as a raw hash (legacy).
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:66
  def build_schema_format(schema); end

  # Convert a RubyLLM tool choice symbol to the Responses API format.
  # Responses API accepts "auto", "required", "none", or
  # { type: "function", name: "fn_name" } for a specific function.
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:54
  def build_tool_choice(choice); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:81
  def extract_last_response_id(messages); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:237
  def extract_output_text(output); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:215
  def extract_text_content(content); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:246
  def extract_tool_calls(output); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:138
  def format_input(messages); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:183
  def format_message_content(content, tool_calls = T.unsafe(nil)); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:228
  def format_role(role); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:262
  def parse_arguments(arguments); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:104
  def parse_completion_response(response); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:16
  def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

  # When chaining via previous_response_id, the API expects only the new
  # items in `input` -- the rest already lives in the server-side response
  # chain. Sending the full history every turn appends it to that chain
  # and causes O(N^2) input_tokens growth. See issue #10.
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:93
  def unchained_messages(messages, last_response_id); end

  class << self
    # Apply tools and tool preferences to the payload.
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:43
    def apply_tools(payload, tools, tool_prefs); end

    # Build the Responses API text format block from a schema.
    # Schema arrives pre-normalized as { name:, schema:, strict: } from
    # RubyLLM::Chat.with_schema (v1.13+), or as a raw hash (legacy).
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:66
    def build_schema_format(schema); end

    # Convert a RubyLLM tool choice symbol to the Responses API format.
    # Responses API accepts "auto", "required", "none", or
    # { type: "function", name: "fn_name" } for a specific function.
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:54
    def build_tool_choice(choice); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:81
    def extract_last_response_id(messages); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:237
    def extract_output_text(output); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:215
    def extract_text_content(content); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:246
    def extract_tool_calls(output); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:138
    def format_input(messages); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:183
    def format_message_content(content, tool_calls = T.unsafe(nil)); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:228
    def format_role(role); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:262
    def parse_arguments(arguments); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:104
    def parse_completion_response(response); end

    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:16
    def render_payload(messages, tools:, temperature:, model:, stream: T.unsafe(nil), schema: T.unsafe(nil), thinking: T.unsafe(nil), tool_prefs: T.unsafe(nil)); end

    # When chaining via previous_response_id, the API expects only the new
    # items in `input` -- the rest already lives in the server-side response
    # chain. Sending the full history every turn appends it to that chain
    # and causes O(N^2) input_tokens growth. See issue #10.
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat.rb:93
    def unchained_messages(messages, last_response_id); end
  end
end

# Extends RubyLLM::Chat to fire on_tool_call / on_tool_result for built-in
# server-side tools (web_search, code_interpreter, file_search, etc.)
# carried on the assistant message. This lets users observe built-in tool
# activity through the same callback API as locally executed function
# tools (issue #1).
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat_extension.rb:11
module RubyLLM::Providers::OpenAIResponses::ChatExtension
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat_extension.rb:12
  def add_message(message_or_attributes); end

  private

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat_extension.rb:26
  def dispatch_built_in_tool_events(message); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat_extension.rb:20
  def dispatch_built_in_tool_events?(message); end

  # Mirrors RubyLLM::Chat#run_callbacks (private since 1.13): dispatches
  # through the new @callbacks array API if present, and always falls
  # back to the legacy @on hash so older ruby_llm versions still work.
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/chat_extension.rb:36
  def fire_callback(new_name, legacy_name, *args); end
end

