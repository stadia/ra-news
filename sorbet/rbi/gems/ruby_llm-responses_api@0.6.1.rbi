  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:69
  def mcp(server_label:, server_url:, require_approval: T.unsafe(nil), allowed_tools: T.unsafe(nil), headers: T.unsafe(nil)); end

  # Parse apply_patch call results from output
  # @param output [Array] Response output array
  # @return [Array<Hash>] Parsed apply_patch call results
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:183
  def parse_apply_patch_results(output); end

  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:296
  def parse_citations(item); end

  # Parse code interpreter results from output
