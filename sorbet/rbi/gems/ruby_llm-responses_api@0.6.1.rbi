# Statefulness support for the OpenAI Responses API.
# Handles conversation state via previous_response_id and store options.
#
# pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:8
module RubyLLM::Providers::OpenAIResponses::State
  private

