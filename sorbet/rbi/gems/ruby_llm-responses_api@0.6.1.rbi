  # @param params [Hash] Additional parameters that may contain state options
  # @return [Hash] Updated payload with state parameters
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:15
  def apply_state_params(payload, params); end

  # Build parameters for continuing a conversation
  # @param previous_response_id [String] The ID of the previous response
  # @param store [Boolean] Whether to store this response (default: true)
  # @return [Hash] Parameters to pass to the next request
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:47
  def continuation_params(previous_response_id, store: T.unsafe(nil)); end

  # Extract response ID from a completed response for chaining
  # @param response [Hash] The API response
  # @return [String, nil] The response ID
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:31
  def extract_response_id(response); end

  # Check if a response was stored
  # @param response [Hash] The API response
  # @return [Boolean]
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:38
  def response_stored?(response); end

  class << self
    # Add state parameters to payload
    # @param payload [Hash] The request payload
    # @param params [Hash] Additional parameters that may contain state options
    # @return [Hash] Updated payload with state parameters
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:15
    def apply_state_params(payload, params); end

    # Build parameters for continuing a conversation
    # @param previous_response_id [String] The ID of the previous response
    # @param store [Boolean] Whether to store this response (default: true)
    # @return [Hash] Parameters to pass to the next request
    #
    # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/state.rb:47
    def continuation_params(previous_response_id, store: T.unsafe(nil)); end

