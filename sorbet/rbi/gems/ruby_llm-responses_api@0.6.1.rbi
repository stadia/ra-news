  def parse_image_generation_results(output); end

  # Parse shell call results from output
  # @param output [Array] Response output array
  # @return [Array<Hash>] Parsed shell call results
  #
  # pkg:gem/ruby_llm-responses_api#lib/ruby_llm/providers/openai_responses/built_in_tools.rb:261
