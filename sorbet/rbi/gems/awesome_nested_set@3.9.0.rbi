  # Returns options for select.
  # You can exclude some items from the tree.
  # You can pass a block receiving an item and returning the string displayed in the select.
  #
  # == Params
  #  * +class_or_items+ - Class name or top level items
  #  * +mover+ - The item that is being move, used to exclude impossible moves
  #  * +&block+ - a block that will be used to display: { |item| ... item.name }
  #
  # == Usage
  #
  #   <%= f.select :parent_id, nested_set_options(Category, @category) {|i|
  #       "#{'–' * i.level} #{i.name}"
  #     }) %>
  #
  # pkg:gem/awesome_nested_set#lib/awesome_nested_set/helper.rb:24
  def nested_set_options(class_or_items, mover = T.unsafe(nil)); end
end

