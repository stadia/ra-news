  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/link_set.rb:351
  def include_index?; end

  # pkg:gem/sitemap_generator#lib/sitemap_generator/link_set.rb:16
  def include_root; end

  # pkg:gem/sitemap_generator#lib/sitemap_generator/link_set.rb:16
  def include_root=(_arg0); end

