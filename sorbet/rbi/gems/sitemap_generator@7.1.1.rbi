# Internal utility functions: hash merging, string manipulation, byte calculation,
# and warning suppression. Not part of the public API.
#
# pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:6
module SitemapGenerator::Utilities
  private

  # Append a slash to `path` if it does not already end in a slash.
  # Returns a string.  Expects a string or Pathname object.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:173
  def append_slash(path); end

  # Make a list of `value` if it is not a list already.  If `value` is
  # nil, an empty list is returned.  If `value` is already a list, return it unchanged.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:68
  def as_array(value); end

  # Validate all keys in a hash match *valid keys, raising ArgumentError on a
  # mismatch. Note that keys are NOT treated indifferently, meaning if you use
  # strings for keys but assert symbols as keys, this will fail.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:42
  def assert_valid_keys(hash, *valid_keys); end

  # An object is blank if it's false, empty, or a whitespace string.
  # For example, "", "   ", +nil+, [], and {} are blank.
  #
  # This simplifies:
  #
  #   if !address.nil? && !address.empty?
  #
  # ...to:
  #
  #   if !address.blank?
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:128
  def blank?(object); end

  # Return the bytesize length of the string.  Ruby 1.8.6 compatible.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:199
  def bytesize(string); end

  # Clean sitemap files in output directory.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:30
  def clean_files; end

  # Return the current time, using Time.zone if available (Rails), otherwise Time.now.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:193
  def current_time; end

  # Replace the last 3 characters of string with ... if the string is as big
  # or bigger than max.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:184
  def ellipsis(string, max); end

  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:167
  def falsy?(value); end

  # Copy templates/sitemap.rb to config if not there yet.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:10
  def install_sitemap_rb(verbose = T.unsafe(nil)); end

  # An object is present if it's not blank.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:144
  def present?(object); end

  # Allows for reverse merging two hashes where the keys in the calling hash take precedence over those
  # in the <tt>other_hash</tt>. This is particularly useful for initializing an option hash with default values:
  #
  #   def setup(options = {})
  #     options.reverse_merge! :size => 25, :velocity => 10
  #   end
  #
  # Using <tt>merge</tt>, the above example would look as follows:
  #
  #   def setup(options = {})
  #     { :size => 25, :velocity => 10 }.merge(options)
  #   end
  #
  # The default <tt>:size</tt> and <tt>:velocity</tt> are only set if the +options+ hash passed in doesn't already
  # have the respective key.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:108
  def reverse_merge(hash, other_hash); end

  # Performs the opposite of <tt>merge</tt>, with the keys and values from the first hash taking
  # precedence over the second. Modifies the receiver in place.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:114
  def reverse_merge!(hash, other_hash); end

  # Rounds the float with the specified precision.
  #
  #   x = 1.337
  #   x.round    # => 1
  #   x.round(1) # => 1.3
  #   x.round(2) # => 1.34
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:84
  def round(float, precision = T.unsafe(nil)); end

  # Return a new hash with all keys converted to symbols, as long as
  # they respond to +to_sym+.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:49
  def symbolize_keys(hash); end

  # Destructively convert all keys to symbols, as long as they respond
  # to +to_sym+.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:55
  def symbolize_keys!(hash); end

  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:157
  def titleize(string); end

  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:163
  def truthy?(value); end

  # Remove config/sitemap.rb if exists.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:23
  def uninstall_sitemap_rb; end

  # Sets $VERBOSE for the duration of the block and back to its original value afterwards.
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/utilities.rb:149
  def with_warnings(flag); end

