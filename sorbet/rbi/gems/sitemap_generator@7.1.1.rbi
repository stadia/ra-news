  # pkg:gem/sitemap_generator#lib/sitemap_generator/builder/sitemap_index_file.rb:100
  def total_link_count; end

  # Write out the index if an index is needed
  #
  # pkg:gem/sitemap_generator#lib/sitemap_generator/builder/sitemap_index_file.rb:118
