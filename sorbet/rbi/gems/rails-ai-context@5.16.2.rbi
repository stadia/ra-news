# Base class for Prism Dispatcher listeners.
# Provides shared helpers for extracting values from AST nodes.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/base_listener.rb:10
class RailsAiContext::Introspectors::Listeners::BaseListener
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/base_listener.rb:13
  def initialize; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/base_listener.rb:11
