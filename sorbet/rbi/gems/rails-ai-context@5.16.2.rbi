# Computes a SHA256 fingerprint of key application files to detect changes.
# Used by BaseTool to invalidate cached introspection when files change.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:8
class RailsAiContext::Fingerprinter
  class << self
    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:112
    def changed?(app, previous); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:35
    def compute(app); end

    # Clear the memoized gem-lib fingerprint. Called by BaseTool.reset_cache!
    # and LiveReload so active gem development gets a fresh scan on next call
    # without requiring a process restart.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:74
    def reset_gem_lib_fingerprint!; end

    private

    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:87
    def compute_gem_lib_fingerprint(root); end

    # Memoized gem-lib fingerprint. Computed ONCE per process lifetime
    # (or per reset_gem_lib_fingerprint! call) instead of on every
    # tool invocation.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:83
    def gem_lib_fingerprint(root); end

    # Detect if this gem is loaded via a local path (path: in Gemfile)
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/fingerprinter.rb:101
    def local_gem_path?; end
  end
end

