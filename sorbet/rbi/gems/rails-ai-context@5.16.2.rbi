# Configures and starts an MCP server using the official Ruby SDK.
# Registers all introspection tools and handles transport selection.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:8
class RailsAiContext::Server
  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:32
  def initialize(app, transport: T.unsafe(nil)); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:9
  def app; end

  # Build and return the configured MCP::Server instance
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:87
  def build; end

  # Start the MCP server with the configured transport
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:125
  def start; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:9
  def transport_type; end

  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:140
  def active_tools(config); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:209
  def build_rack_app(transport, path); end

  # Conditionally start live reload based on configuration.
  # :auto  - try to load `listen`, skip silently with a tip if missing
  # true   - try to load `listen`, raise if missing
  # false  - skip entirely
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:190
  def maybe_start_live_reload(mcp_server); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:158
  def start_http(server); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:148
  def start_stdio(server); end

  class << self
    # All built-in tools, auto-discovered from Tools::BaseTool subclasses.
    # Kept as a class method (not a constant) so auto-registration works.
    # Legacy constant accessor preserved for backwards compatibility.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:14
    def builtin_tools; end

    # Backwards-compatible constant - delegates to the registry.
    # Existing code referencing Server::TOOLS continues to work.
    # Emits a deprecation notice once to guide migration.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:21
    def const_missing(name); end

    # Resolve config.custom_tools into MCP::Tool classes. Entries may be
    # classes or class-name strings: classes in app/ (e.g. app/mcp_tools/)
    # are not autoloadable while config/initializers run, so referencing the
    # constant there aborts boot - a string name defers resolution to here,
    # where autoloading is ready. Invalid entries are warn-skipped so one bad
    # entry cannot take down every tool invocation.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/server.rb:43
    def resolve_custom_tools(config = T.unsafe(nil)); end
  end
end

# Source-scanning helpers for the tools that read Ruby without a full
# parse (Turbo broadcast scans, retry_on option scans).
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:6
module RailsAiContext::SourceLine
  private

  # The executable portion of one source line for call-site scanning.
  # A `def` line - including visibility-prefixed forms like `private def`
  # or `private_class_method def self.x` - contributes only its body:
  # nothing for a plain signature (names and parameter defaults are
  # declarations, not calls: `def notify(via: :broadcast_x_to)`), the
  # part after a top-level `=` for an endless method, and the part after
  # a top-level `;` for a classic one-liner (`def x; call; end`).
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:133
  def executable_part(line); end

  # The delimiter of a %-literal starting at chars[i] ("%"), or nil when
  # this % is arithmetic/format (e.g. `n % 2`, `"%s" % x`).
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:196
  def percent_delimiter(chars, i); end

  # Single-line form, kept for call sites that scan line by line.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:122
  def strip_comment(line); end

  # Remove Ruby comments from a source fragment (a single line or several
  # joined lines), respecting string, backtick, and %-literals: a '#'
  # inside "..."/'...'/`...`/%w[...] is content, and interpolation braces
  # are tracked so a '#' after a closed interpolation still counts as
  # inside its literal. Literal state carries across newlines, so a
  # multi-line string does not lose its tail, and =begin/=end block
  # comments are removed up front. Heuristic, not a lexer - /regex/
  # literals, ?# char literals, and heredoc bodies are not modeled.
  # Newlines and any trailing-newline shape are preserved.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:29
  def strip_comments(text); end

  class << self
    # The executable portion of one source line for call-site scanning.
    # A `def` line - including visibility-prefixed forms like `private def`
    # or `private_class_method def self.x` - contributes only its body:
    # nothing for a plain signature (names and parameter defaults are
    # declarations, not calls: `def notify(via: :broadcast_x_to)`), the
    # part after a top-level `=` for an endless method, and the part after
    # a top-level `;` for a classic one-liner (`def x; call; end`).
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:133
    def executable_part(line); end

    # The delimiter of a %-literal starting at chars[i] ("%"), or nil when
    # this % is arithmetic/format (e.g. `n % 2`, `"%s" % x`).
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:196
    def percent_delimiter(chars, i); end

    # Single-line form, kept for call sites that scan line by line.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:122
    def strip_comment(line); end

    # Remove Ruby comments from a source fragment (a single line or several
    # joined lines), respecting string, backtick, and %-literals: a '#'
    # inside "..."/'...'/`...`/%w[...] is content, and interpolation braces
    # are tracked so a '#' after a closed interpolation still counts as
    # inside its literal. Literal state carries across newlines, so a
    # multi-line string does not lose its tail, and =begin/=end block
    # comments are removed up front. Heuristic, not a lexer - /regex/
    # literals, ?# char literals, and heredoc bodies are not modeled.
    # Newlines and any trailing-newline shape are preserved.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:29
    def strip_comments(text); end
  end
end

# Literals whose bodies interpolate (so "#{...}" must be tracked).
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:16
RailsAiContext::SourceLine::INTERPOLATING = T.let(T.unsafe(nil), Array)

# Paired delimiters nest; anything else closes on the same character.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:13
RailsAiContext::SourceLine::PERCENT_PAIRS = T.let(T.unsafe(nil), Hash)

# %-literal type letters that open a string-like literal (%w[], %i(),
# %q{}, %r//, %x``, ...). A bare % followed by a non-alphanumeric
# delimiter (%(...)) opens one too.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/source_line.rb:10
RailsAiContext::SourceLine::PERCENT_TYPES = T.let(T.unsafe(nil), String)

# Stand-in for Rails.application when serving the static tier (app not
