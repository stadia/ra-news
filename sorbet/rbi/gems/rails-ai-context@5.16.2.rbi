# Generates .cursor/rules/*.mdc files (new Cursor MDC format) AND a
# .cursorrules legacy fallback at the project root.
#
# Why both:
#   - .cursor/rules/*.mdc is the recommended format for Cursor 0.42+
#     with per-file scoping (alwaysApply / globs / description triggers)
#   - .cursorrules is still consulted by Cursor's chat agent in many
#     versions and is the only format older clients understand. Real
#     user report (v5.9.0 release QA): the chat agent didn't detect
#     rules written only as .cursor/rules/*.mdc; adding .cursorrules
#     alongside fixed it.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:16
class RailsAiContext::Serializers::CursorRulesSerializer
  include ::RailsAiContext::Serializers::TestCommandDetection
  include ::RailsAiContext::Serializers::StackOverviewHelper
  include ::RailsAiContext::Serializers::ToolGuideHelper
  include ::RailsAiContext::Serializers::CompactSerializerHelper

  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:24
  def initialize(context); end

  # @param output_dir [String] Rails root path
  # @return [Hash] { written: [paths], skipped: [paths] }
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:30
  def call(output_dir); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:22
  def context; end

  private

  # Auto-attached when working in app/controllers/
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:159
  def render_controllers_rule; end

  # Legacy .cursorrules fallback. Same content pipeline as CLAUDE.md
  # (render_compact_rules from CompactSerializerHelper) - both files
  # give an AI agent the same project context; only the filename /
  # distribution mechanism differs. Cursor's chat agent reads
  # .cursorrules unconditionally in every version, so this serves as
  # the guaranteed fallback while .cursor/rules/*.mdc is the
  # preferred-when-supported scoped format.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:206
  def render_cursorrules_legacy; end

  # Agent-requested MCP tool reference - loaded on-demand when agent needs tool guidance
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:185
  def render_mcp_tools_rule; end

  # Auto-attached when working in app/models/
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:125
  def render_models_rule; end

  # Always-on project overview rule (<50 lines)
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/serializers/cursor_rules_serializer.rb:62
  def render_project_rule; end
end

