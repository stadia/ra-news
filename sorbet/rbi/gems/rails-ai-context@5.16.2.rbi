# Detects how the gem is installed into the current app so user-facing copy
# can advertise invocation forms that actually exist.
#
# A standalone install runs the gem via its own CLI binary (`gem install
# rails-ai-context` + `rails-ai-context init`) rather than through the host
# app's Bundler group, so none of the rake tasks this gem ships (`rails
# ai:*`) are available - only the `rails-ai-context` binary works. Detected
# by scanning the resolved Gemfile.lock for a rails-ai-context spec line.
# Falls back to treating the install as in-Gemfile (the common case) when
# the lock file can't be read.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/install_mode.rb:16
module RailsAiContext::InstallMode
  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/install_mode.rb:19
  def standalone?; end

  class << self
    # pkg:gem/rails-ai-context#lib/rails_ai_context/install_mode.rb:19
    def standalone?; end
  end
end

# Bridges MCP gem instrumentation to ActiveSupport::Notifications.
# Enables Rails apps to subscribe to MCP events (tool calls, resource reads, etc.).
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/instrumentation.rb:6
module RailsAiContext::Instrumentation
  class << self
    # Build a safe payload from the raw MCP SDK data hash. Strips tool
    # arguments unless the user has explicitly opted in.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/instrumentation.rb:50
    def build_payload(data); end

    # Returns a lambda for MCP::Configuration#instrumentation_callback.
    # Instruments each MCP method call as an ActiveSupport::Notifications event.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/instrumentation.rb:24
    def callback; end
  end
end

# pkg:gem/rails-ai-context#lib/rails_ai_context/instrumentation.rb:7
RailsAiContext::Instrumentation::EVENT_PREFIX = T.let(T.unsafe(nil), String)

# Metadata-only fields forwarded to ActiveSupport::Notifications. We
# deliberately exclude `tool_arguments`, `params`, `arguments`, and
# `request` because the MCP SDK includes raw tool inputs in those keys.
# e.g. `rails_query(sql: "SELECT password_digest...")`, `rails_get_env(name: "SECRET_KEY_BASE")`,
# `rails_read_logs(search: "api_key=xyz")`. Forwarding them unredacted
# would leak the request-side data that each tool's response-side
# redaction was specifically designed to protect. Fixed in v5.8.1.
#
# Users who legitimately need tool arguments in observability can set
# config.instrumentation_include_arguments = true in an initializer
# (see CONFIGURATION.md for the redaction obligation that comes with it).
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/instrumentation.rb:20
RailsAiContext::Instrumentation::SAFE_KEYS = T.let(T.unsafe(nil), Array)

# Orchestrates all sub-introspectors to build a complete
# picture of the Rails application for AI consumption.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:8
class RailsAiContext::Introspector
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:11
  def initialize(app); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:9
  def app; end

  # Run all configured introspectors and return unified context hash
  #
  # @return [Hash] complete application context
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:19
  def call; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:9
  def config; end

  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:101
  def app_name; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:133
  def environment_name; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:127
  def rails_version; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:141
  def resolve_introspector(name); end

  # Static tier: only introspectors that declare a static_call can produce
  # data without a booted app; everything else is honestly unavailable
  # rather than crashing into a misleading per-section error.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:114
  def run_introspector(introspector); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspector.rb:121
  def unavailable_reason; end
end

