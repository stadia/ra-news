  def model_dirs(root); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/path_resolver.rb:16
  def view_dirs(root); end

  class << self
    # pkg:gem/rails-ai-context#lib/rails_ai_context/path_resolver.rb:14
    def controller_dirs(root); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/path_resolver.rb:18
