# Static walker for config/routes.rb. Resolves the routing DSL's block
# nesting (namespace/scope/resources/member/collection) into flat route
# records so "does this route exist and which controller serves it" can
# be answered without booting the app. Constructs whose routes depend on
# runtime state (devise_for, draw, computed names) are recorded as
# :dynamic markers rather than guessed at. Leading-slash paths and
# constraints are simplified: paths anchor at the accumulated prefix,
# constraints are ignored.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:16
class RailsAiContext::Introspectors::Listeners::RoutesDslListener < ::RailsAiContext::Introspectors::Listeners::BaseListener
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:23
  def initialize; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:28
  def on_call_node_enter(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:45
  def on_call_node_leave(node); end

  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:325
  def current_name_prefix; end

  # Each scope-introducing frame precomputes the absolute path prefix
  # its children see, so nesting composes in any order (namespace
  # inside resources, resources inside scope, ...).
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:62
  def current_prefix; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:330
  def current_resource; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:166
  def edit_path(base, singular); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:255
  def emit(node, verb, path, controller, action, name); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:272
  def emit_dynamic(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:140
  def emit_resource_routes(node, name, opts, singular:); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:244
  def emit_root(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:170
  def emit_verb_route(node); end

  # member/collection blocks push their own prefix, so inside them the
  # general prefix already points at the right base; only the explicit
  # on: keyword needs special handling.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:193
  def enter_member_collection(node, kind); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:67
  def enter_namespace(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:88
  def enter_scope(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:100
  def handle_resources(node, singular:); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:365
  def join_path(*segments); end

  # First positional argument when it is a plain symbol/string literal.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:298
  def literal_first_arg(node); end

  # The member/collection frame a verb route sits in, if any - either
  # from an enclosing member/collection block or an explicit on: keyword.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:205
  def member_collection_kind(on_option); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:162
  def member_path(base, singular); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:360
  def plain_segment_name(segment); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:319
  def prefixed_controller(controller); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:51
  def push_frame(node, **attrs); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:305
  def requested_actions(all, opts); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:230
  def resolve_target(target, segment); end

  # Rails maps a singular resource to the plural controller
  # (resource :profile -> ProfilesController).
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:314
  def resource_controller(name, opts, singular: T.unsafe(nil)); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:335
  def route_name_for(resource_name); end

  # Keyword options including hash-rocket string keys, so
  # `get "up" => "rails/health#show", as: :x` yields
  # {"up" => "rails/health#show", as: :x}.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:281
  def route_options(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:55
  def suppressed?; end

  # A to: value the parser can't read as a literal "controller#action"
  # string (a helper call like redirect(...), a symbol, a constant, or
  # a string with no "#") can't be split into a controller and action,
  # so it must not feed the segment-based guessing in resolve_target.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:226
  def unreadable_target?(target); end

  # Member/collection-scoped verb routes name themselves "<action>_<resource>"
  # (preview_post, archived_posts) rather than the ordinary
  # "<prefix>_<action>" pattern used elsewhere, and an as: override
  # replaces only the action part, not the whole name.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:343
  def verb_route_name(as_option, segment, on_option); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:212
  def verb_route_path(segment, on_option); end
end

# pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/listeners/routes_dsl_listener.rb:21
RailsAiContext::Introspectors::Listeners::RoutesDslListener::DYNAMIC_MACROS = T.let(T.unsafe(nil), Array)

