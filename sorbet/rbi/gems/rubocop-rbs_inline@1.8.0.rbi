  private

  # @rbs annotation:
  #   RBS::Inline::AST::Annotations::VarType |
  #   RBS::Inline::AST::Annotations::BlockType |
  #   RBS::Inline::AST::Annotations::SplatParamType |
  #   RBS::Inline::AST::Annotations::DoubleSplatParamType
