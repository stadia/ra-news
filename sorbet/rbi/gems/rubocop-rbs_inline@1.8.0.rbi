  include ::RuboCop::Cop::RangeHelp
  extend ::RuboCop::Cop::AutoCorrector

  # pkg:gem/rubocop-rbs_inline#lib/rubocop/cop/style/rbs_inline/require_rbs_inline_comment.rb:74
