  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:88
  def initialize(video_id, reason = T.unsafe(nil), sub_reasons = T.unsafe(nil)); end

  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:94
  def cause_message; end

  # @return [String, nil] the reason the video is unplayable
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:80
  def reason; end

  # @return [Array<String>] additional sub-reasons
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:83
  def sub_reasons; end
end

