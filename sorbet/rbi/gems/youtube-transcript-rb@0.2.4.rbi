#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:25
class YoutubeRb::Transcript::TranscriptListFetcher
  # @param http_client [Faraday::Connection] the HTTP client to use
  # @param proxy_config [Object, nil] optional proxy configuration
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:28
  def initialize(http_client:, proxy_config: T.unsafe(nil)); end

  # Fetch the transcript list for a video
  #
  # @param video_id [String] the YouTube video ID
  # @return [TranscriptList] the list of available transcripts
  # @raise [CouldNotRetrieveTranscript] if transcripts cannot be retrieved
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:38
  def fetch(video_id); end

  private

  # Assert that the video is playable
  #
  # @param playability_status_data [Hash, nil] the playability status from API
  # @param video_id [String] the video ID
  # @raise [Various] depending on the playability status
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:105
  def assert_playability(playability_status_data, video_id); end

  # Create a consent cookie from the HTML
  #
  # @param html [String] the HTML content
  # @param video_id [String] the video ID
  # @raise [FailedToCreateConsentCookie] if the cookie cannot be created
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:139
  def create_consent_cookie(html, video_id); end

  # Extract captions JSON from innertube data
  #
  # @param innertube_data [Hash] the innertube API response
  # @param video_id [String] the video ID
  # @return [Hash] the captions JSON
  # @raise [TranscriptsDisabled] if no captions are available
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:91
  def extract_captions_json(innertube_data, video_id); end

  # Extract the INNERTUBE_API_KEY from the video page HTML
  #
  # @param html [String] the HTML content
  # @param video_id [String] the video ID (for error messages)
  # @return [String] the API key
  # @raise [IpBlocked] if a CAPTCHA is detected
  # @raise [YouTubeDataUnparsable] if the key cannot be found
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:76
  def extract_innertube_api_key(html, video_id); end

  # Fetch captions JSON with retry support
  #
  # @param video_id [String] the YouTube video ID
  # @param try_number [Integer] current retry attempt
  # @return [Hash] the captions JSON
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:53
  def fetch_captions_json(video_id, try_number: T.unsafe(nil)); end

  # Fetch raw HTML from YouTube
  #
  # @param video_id [String] the video ID
  # @return [String] the HTML content (unescaped)
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:169
  def fetch_html(video_id); end

  # Fetch data from the Innertube API
  #
  # @param video_id [String] the video ID
  # @param api_key [String] the API key
  # @return [Hash] the API response
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:189
  def fetch_innertube_data(video_id, api_key); end

  # Fetch the video HTML page
  #
  # @param video_id [String] the video ID
  # @return [String] the HTML content
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:153
  def fetch_video_html(video_id); end

  # Raise appropriate errors for HTTP responses
  #
  # @param response [Faraday::Response] the HTTP response
  # @param video_id [String] the video ID
  # @raise [IpBlocked] for 429 responses
  # @raise [YouTubeRequestFailed] for other error responses
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_list_fetcher.rb:210
  def raise_http_errors(response, video_id); end
end

# Represents transcript metadata and provides fetch/translate capabilities
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:127
class YoutubeRb::Transcript::TranscriptMetadata
  # @param http_client [Faraday::Connection] the HTTP client
  # @param video_id [String] the YouTube video ID
  # @param url [String] the transcript URL
  # @param language [String] the language name
  # @param language_code [String] the language code
  # @param is_generated [Boolean] whether auto-generated
  # @param translation_languages [Array<TranslationLanguage>] available translations
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:150
  def initialize(http_client:, video_id:, url:, language:, language_code:, is_generated:, translation_languages:); end

  # Fetch the actual transcript data
  # @param preserve_formatting [Boolean] whether to preserve HTML formatting
  # @return [FetchedTranscript] the fetched transcript
  # @raise [PoTokenRequired] if a PO token is required
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:167
  def fetch(preserve_formatting: T.unsafe(nil)); end

  # Check if transcript was auto-generated
  # @return [Boolean]
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:214
  def generated?; end

  # @return [Boolean] whether auto-generated
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:138
  def is_generated; end

  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:190
  def is_translatable; end

  # @return [String] the language name
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:132
  def language; end

  # @return [String] the language code
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:135
  def language_code; end

  # String representation of the transcript
  # @return [String]
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:220
  def to_s; end

  # Check if this transcript can be translated
  # @return [Boolean]
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:187
  def translatable?; end

  # Translate this transcript to another language
  # @param language_code [String] the target language code
  # @return [TranscriptMetadata] a new TranscriptMetadata object for the translated version
  # @raise [NotTranslatable] if the transcript cannot be translated
  # @raise [TranslationLanguageNotAvailable] if the language is not available
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:197
  def translate(language_code); end

  # @return [Array<TranslationLanguage>] available translation languages
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:141
  def translation_languages; end

  # @return [String] the video ID
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:129
  def video_id; end

  private

  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:227
  def raise_http_errors(response); end
end

# Parses XML transcript data from YouTube
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:9
class YoutubeRb::Transcript::TranscriptParser
  # @param preserve_formatting [Boolean] whether to preserve HTML formatting tags
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:25
  def initialize(preserve_formatting: T.unsafe(nil)); end

  # Parse XML transcript data into TranscriptSnippet objects
  # @param raw_data [String] the raw XML data from YouTube
  # @return [Array<TranscriptSnippet>] parsed transcript snippets
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:33
  def parse(raw_data); end

  private

  # Build regex for removing HTML tags
  # @return [Regexp]
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:58
  def build_html_regex; end

  # Process text by unescaping HTML entities and removing unwanted tags
  # @param text [String] the raw text
  # @return [String] processed text
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:73
  def process_text(text); end
end

# HTML formatting tags to preserve when preserve_formatting is enabled
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript_parser.rb:11
YoutubeRb::Transcript::TranscriptParser::FORMATTING_TAGS = T.let(T.unsafe(nil), Array)

# Represents a single transcript snippet/segment
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:22
class YoutubeRb::Transcript::TranscriptSnippet
  # @param text [String] the text content
  # @param start [Float] the start time in seconds
  # @param duration [Float] the duration in seconds
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:35
  def initialize(text:, start:, duration:); end

  # @return [Float] the duration in seconds
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:30
  def duration; end

  # @return [Float] the start time in seconds
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:27
  def start; end

  # @return [String] the text content of the snippet
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:24
  def text; end

  # Convert to hash representation
  # @return [Hash] hash with text, start, and duration keys
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:43
  def to_h; end
end

# Raised when transcripts are disabled for a video
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:149
class YoutubeRb::Transcript::TranscriptsDisabled < ::YoutubeRb::Transcript::CouldNotRetrieveTranscript; end

# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:150
YoutubeRb::Transcript::TranscriptsDisabled::CAUSE_MESSAGE = T.let(T.unsafe(nil), String)

# Represents a language available for translation
#
# pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:6
class YoutubeRb::Transcript::TranslationLanguage
  # @param language [String] the language name
  # @param language_code [String] the language code
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:15
  def initialize(language:, language_code:); end

  # @return [String] the language name (e.g., "Spanish")
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:8
  def language; end

  # @return [String] the language code (e.g., "es")
  #
  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/transcript.rb:11
  def language_code; end
end

