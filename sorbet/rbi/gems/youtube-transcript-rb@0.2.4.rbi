  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:65
  def initialize(video_id, http_error); end

  # pkg:gem/youtube-transcript-rb#lib/youtube_rb/transcript/errors.rb:70
  def cause_message; end

