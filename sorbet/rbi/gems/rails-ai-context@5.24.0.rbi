  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:16
  def singleton_method_names_by_scope; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:16
  def validates_calls; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:67
  def visit_call_node(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:53
  def visit_class_node(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:61
  def visit_def_node(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:57
  def visit_module_node(node); end

  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:112
  def current_method_kind; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:108
  def current_scope; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:182
  def extract_callback(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:164
  def extract_has_many(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:145
  def extract_permit(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:116
  def extract_render(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:135
  def extract_validates(node); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:104
  def method_names_for(method_kind, scope); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:97
  def with_method_context(method_kind); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:90
  def with_scope(scope_name); end
end

# pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:21
RailsAiContext::Tools::ValidateSemantics::RailsSemanticVisitor::CALLBACK_NAMES = T.let(T.unsafe(nil), Set)

# pkg:gem/rails-ai-context#lib/rails_ai_context/tools/validate_semantics.rb:20
RailsAiContext::Tools::ValidateSemantics::RailsSemanticVisitor::TOP_LEVEL_SCOPE = T.let(T.unsafe(nil), String)

# pkg:gem/rails-ai-context#lib/rails_ai_context/version.rb:4
RailsAiContext::VERSION = T.let(T.unsafe(nil), String)

# Virtual File System - pattern-matched URI routing for MCP resources.
# Each resolve call introspects fresh (zero stale data).
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:8
module RailsAiContext::VFS
  class << self
    # Resolve a rails-ai-context:// URI to MCP resource content.
    # Returns an array of content hashes: [{uri:, mimeType:, text:}].
    # Keys are MCP-spec camelCase because the MCP SDK serializes the
    # resources/read handler's return value into the JSON-RPC response
    # verbatim - a snake_case :mime_type key would reach clients unchanged.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:25
    def resolve(uri); end

    private

    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:60
    def resolve_controller(uri, name); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:80
    def resolve_controller_action(uri, controller_name, action_name); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:38
    def resolve_model(uri, name); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:204
    def resolve_routes(uri, controller); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:122
    def resolve_view(uri, path); end
  end
end

# pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:11
RailsAiContext::VFS::PATTERNS = T.let(T.unsafe(nil), Array)

# pkg:gem/rails-ai-context#lib/rails_ai_context/vfs.rb:9
RailsAiContext::VFS::SCHEME = T.let(T.unsafe(nil), String)

# Regenerates context files when the app changes. The loop - watch list,
# fingerprint gate, code reload - is ChangeWatch's; this supplies the
# blocking foreground behavior and the regeneration reaction. Interactive
# by nature, so it also gets the one-time legacy-files prompt the
# server-side reload deliberately skips.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:9
class RailsAiContext::Watcher
  # pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:12
  def initialize(app = T.unsafe(nil)); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:10
  def app; end

  # Run one change batch through the shared gate. Public for testability -
  # specs drive this instead of a real Listen thread.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:55
  def handle_change(paths = T.unsafe(nil)); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:17
  def start; end

  private

  # pkg:gem/rails-ai-context#lib/rails_ai_context/watcher.rb:61
  def regenerate; end
end
