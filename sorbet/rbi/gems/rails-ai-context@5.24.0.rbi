  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:153
  def events; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:212
  def index_entry(event); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:112
  def initialize_from_tables(tables, source, path); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:128
  def parse; end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:110
  def path; end

  class << self
    # The source-choosing entry. Mirrors the schema introspector's cascade:
    # a dump that parses to zero tables falls through to the next source.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:24
