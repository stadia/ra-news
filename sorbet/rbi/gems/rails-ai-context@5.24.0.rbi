# pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:5
class RailsAiContext::Tools::GetFrontendStack < ::RailsAiContext::Tools::BaseTool
  extend ::RailsAiContext::Tools::SafeCall

  class << self
    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:30
    def call(**kwargs); end

    private

    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:186
    def build_full(data); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:80
    def build_hotwire_summary; end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:109
    def build_standard(data); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:49
    def build_summary(data); end

    # :vite_rails -> "Vite Rails", "vite" -> "Vite"
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:242
    def display_name(value); end

    # For Hotwire/importmap apps, pull Stimulus and Turbo data from context
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:257
    def enrich_with_hotwire(lines); end

    # The introspector emits frameworks as a hash of framework symbol =>
    # package.json version requirement (e.g. { react: "^19.0.0" }), not a
    # singular framework/version pair. Render the primary (first) entry,
    # stripping range operators from the version.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:231
    def framework_label(data); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/tools/get_frontend_stack.rb:246
    def total_component_count(data); end
  end
end

