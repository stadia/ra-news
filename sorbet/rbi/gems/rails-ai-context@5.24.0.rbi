  def payload(names); end

  # The payload sense: a module in the ancestor chain that is part of the
  # class's story. Framework plumbing and the stdlib are not; a gem
  # capability module (Devise::Models::*, Turbo::Broadcastable) is.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:24
  def payload?(name); end

  class << self
    # The narrower display sense: concerns the app itself defines, decided by
    # whether ConcernPaths can name their file.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:61
    def app_owned(names, root); end

    # Booted reading: the ancestor chain's non-class modules, through the
    # payload rule.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:41
    def from_ancestors(klass); end

    # Static reading: only the mixins reflection would report (the listener's
    # ancestor flag), through the same rule, so both tiers answer alike.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:51
    def from_mixins(mixins); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:35
    def payload(names); end

    # The payload sense: a module in the ancestor chain that is part of the
    # class's story. Framework plumbing and the stdlib are not; a gem
    # capability module (Devise::Models::*, Turbo::Broadcastable) is.
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/concern_membership.rb:24
    def payload?(name); end
  end
end

