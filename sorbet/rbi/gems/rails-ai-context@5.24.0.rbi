  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:67
  def with_source(source); end

  private

  # Returns the table each subsequent column and index belongs to.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/schema_reader.rb:171
  def absorb(event, schema, current); end

