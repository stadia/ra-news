# class is called. Name checks first - the constants may not be loaded
# in the process asking.
#
# pkg:gem/rails-ai-context#lib/rails_ai_context/introspectors/action_resolver.rb:16
RailsAiContext::Introspectors::ActionResolver::KINDS = T.let(T.unsafe(nil), Hash)

