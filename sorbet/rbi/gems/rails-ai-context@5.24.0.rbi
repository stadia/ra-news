  # Either form counts as guarded, so a re-run neither double-wraps an
  # initializer nor treats an unguarded one as guarded.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/install/initializer_file.rb:27
  def guarded?(content); end

  class << self
    # pkg:gem/rails-ai-context#lib/rails_ai_context/install/initializer_file.rb:21
    def bare_guard?(content); end

    # Either form counts as guarded, so a re-run neither double-wraps an
    # initializer nor treats an unguarded one as guarded.
    #
