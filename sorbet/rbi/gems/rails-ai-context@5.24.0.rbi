  # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:142
  def relative_to(path, root); end

  # @param surface [#say, #ask] ask returns the user's line, nil on EOF
  # @return [Array<Symbol>] never empty; every tool when nothing usable
  #   was entered, stated out loud so --defaults and EOF read the same.
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:24
  def select_ai_tools(surface); end

  # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:52
  def select_tool_mode(surface); end

  # `standalone: nil` lets the generator detect the install mode from
  # Gemfile.lock, so every entry writes the same command form for the
  # same app (no config ping-pong).
  #
  # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:131
  def write_mcp_configs(surface, tools:, tool_mode:, root:, standalone: T.unsafe(nil)); end

  class << self
    # Offers to remove what a re-run dropped from the selection. `keeping:`
    # protects files the remaining tools share (AGENTS.md).
    #
    # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:68
    def cleanup_removed_tools(surface, previous:, selected:, root:); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:110
    def mark_gitignore(surface, root:); end

    # pkg:gem/rails-ai-context#lib/rails_ai_context/install/program.rb:142
    def relative_to(path, root); end

    # @param surface [#say, #ask] ask returns the user's line, nil on EOF
    # @return [Array<Symbol>] never empty; every tool when nothing usable
    #   was entered, stated out loud so --defaults and EOF read the same.
    #
