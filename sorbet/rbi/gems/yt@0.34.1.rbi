# pkg:gem/yt#lib/yt/collections/related_playlists.rb:5
class Yt::Collections::RelatedPlaylists < ::Yt::Collections::Playlists
  private

  # Since there are at most 5 related playlists, they can be eager-loaded.
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:32
  def eager_load_items_from(items); end

  # The related playlists are nested inside the "relatedPlaylists" key.
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:25
  def extract_items(list); end

  # Retrieving related playlists requires to hit the /channels endpoint.
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:10
  def list_resources; end

  # Related playlists are eager-loaded, there’s no need to load them again.
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:38
  def new_item(playlist); end

  # The related playlists are included in the content details of a channel.
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:15
  def playlists_params; end

  # The object to create is "Yt::Models::Playlist", not "RelatedPlaylist"
  #
  # pkg:gem/yt#lib/yt/collections/related_playlists.rb:20
  def resource_class; end
end

