  # pkg:gem/yt#lib/yt/models/policy_rule.rb:111
  def reference_duration_list; end

  # pkg:gem/yt#lib/yt/models/policy_rule.rb:115
  def reference_percent_list; end

  # pkg:gem/yt#lib/yt/models/policy_rule.rb:99
