  # pkg:gem/semantic_logger#lib/semantic_logger/reporters/minitest.rb:30
  def before_test(test); end

  # pkg:gem/semantic_logger#lib/semantic_logger/reporters/minitest.rb:28
  def io; end

  # pkg:gem/semantic_logger#lib/semantic_logger/reporters/minitest.rb:28
  def io=(_arg0); end

  # pkg:gem/semantic_logger#lib/semantic_logger/reporters/minitest.rb:24
  def logger; end

  # pkg:gem/semantic_logger#lib/semantic_logger/reporters/minitest.rb:24
