  # Unlike the JSON formatters there is no single `.to_json` boundary here:
  # the hash is handed to the OTLP exporter, which requires valid UTF-8. Cleanse
  # the whole structure so binary / non UTF-8 strings cannot break the export.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:13
  def call(log, logger); end

  # Log level
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:18
  def level; end

  # Payload is submitted directly as attributes
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:24
  def payload; end

  private

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:41
  def coerce_map(h); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:32
  def coerce_value(v); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:58
  def severity_number(severity); end
end

# primitives allowed by OTLP logs in Ruby: String, Integer, Float, TrueClass, FalseClass
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:6
SemanticLogger::Formatters::OpenTelemetry::PRIMS = T.let(T.unsafe(nil), Array)

# Formats log messages using a configurable pattern string, so a custom
# log line layout can be specified directly in the configuration without
# having to write a new formatter class.
#
# Pattern placeholders use the form `%{directive}`, where `directive` is the
# name of any of the formatting methods (inherited from Default, or defined
# below). Named tags support a parameterized form: `%{named_tags:request_id}`
# returns the value of a single named tag. Use `%%{...}` to emit a literal
# `%{...}` without interpolation.
#
# Example:
#   SemanticLogger.add_appender(
#     io:        $stdout,
#     formatter: {
#       pattern: { pattern: "%{time} %{level} %{name} -- %{message}" }
#     }
#   )
#
# Available directives:
#   time                 Formatted timestamp. Optionally accepts a strftime
#                        format, e.g. time:%Y-%m-%dT%H:%M:%S.%6N.
#   level                Full level name, e.g. "debug".
#   level_short          Single character level, e.g. "D".
#   name                 Logger / class name.
#   message              Log message.
#   payload              Payload rendered as a string.
#   exception_class      Class of the logged exception, e.g. "RuntimeError".
#   exception_message    Message of the logged exception.
#   backtrace            Backtrace of the logged exception.
#   duration             Human readable duration, e.g. "1.2ms".
#   duration_ms          Duration in milliseconds (numeric).
#   thread_name          Name of the thread that logged the message.
#   pid                  Process id.
#   file_name            Ruby file name that logged the message, e.g. "app.rb".
#   line                 Line number within the Ruby file, e.g. 42.
#   tags                 Tags, comma separated.
#   named_tags           All named tags, or one tag with named_tags:key.
#   host                 Host name.
#   application          Application name.
#   environment          Environment name.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:45
class SemanticLogger::Formatters::Pattern < ::SemanticLogger::Formatters::Default
  # Parameters:
  #   pattern: [String]
  #     The pattern string used to format every log entry.
  #     Default: DEFAULT_PATTERN
  #
  # Plus all the options supported by SemanticLogger::Formatters::Base.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:86
  def initialize(pattern: T.unsafe(nil), **args); end

  # Application name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:187
  def application; end

  # Backtrace of the logged exception.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:135
  def backtrace; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:196
  def call(log, logger); end

  # Human readable duration (without the Default formatter's surrounding parentheses).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:140
  def duration; end

  # Duration in milliseconds.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:145
  def duration_ms; end

  # Environment name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:192
  def environment; end

  # Class of the logged exception, e.g. "RuntimeError".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:125
  def exception_class; end

  # Message of the logged exception.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:130
  def exception_message; end

  # Name of the Ruby file that logged the message, e.g. "app.rb".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:150
  def file_name; end

  # Host name.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:182
  def host; end

  # Full level name, e.g. "debug" (Default formatter uses the short "D").
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:105
  def level; end

  # Single character level, e.g. "D".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:110
  def level_short; end

  # Line number within the Ruby file that logged the message.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:155
  def line; end

  # Log message (without the "-- " prefix the Default formatter adds).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:115
  def message; end

  # With a key: the value of a single named tag, e.g. %{named_tags:request_id}.
  # Without a key: all named tags rendered as "key: value, ...".
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:168
  def named_tags(key = T.unsafe(nil)); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:46
  def pattern; end

  # Raw payload rendered as a string.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:120
  def payload; end

  # Tags joined by a comma (without the Default formatter's surrounding brackets).
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:160
  def tags; end

  # Formatted timestamp. With a strftime format argument, e.g.
  # %{time:%Y-%m-%dT%H:%M:%S.%6N}, the time is formatted with that string.
  # Without an argument it uses the formatter's configured time_format.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:98
  def time(format = T.unsafe(nil)); end

  private

  # Parse the pattern string into an array of tokens: frozen literal strings
  # and Token structs for each %{directive} placeholder. %%{...} is an escape
  # that produces a literal %{...}.
  #
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:210
  def compile(string); end
end

# Approximates the Default formatter's output.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:49
SemanticLogger::Formatters::Pattern::DEFAULT_PATTERN = T.let(T.unsafe(nil), String)

# The directives that may appear in a pattern. The value is whether the
# directive accepts a parameter, e.g. %{named_tags:request_id}.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:53
SemanticLogger::Formatters::Pattern::DIRECTIVES = T.let(T.unsafe(nil), Hash)

# A single interpolated directive within a compiled pattern.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
class SemanticLogger::Formatters::Pattern::Token < ::Struct
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
  def arguments; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
  def arguments=(_); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
  def method_name; end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
  def method_name=(_); end

  class << self
    # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
    def [](*_arg0); end

    # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
    def inspect; end

    # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
    def keyword_init?; end

    # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
    def members; end

    # pkg:gem/semantic_logger#lib/semantic_logger/formatters/pattern.rb:77
    def new(*_arg0); end
  end
end

