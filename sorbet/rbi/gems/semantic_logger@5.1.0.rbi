SemanticLogger::Formatters::Ecs::ECS_VERSION = T.let(T.unsafe(nil), String)

# Fluentd is similar to SemanticLogger::Formatters::Json but with log levels that are recognized
# by kubernetes fluentd.
#
# pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:7
class SemanticLogger::Formatters::Fluentd < ::SemanticLogger::Formatters::Json
  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:10
  def initialize(time_format: T.unsafe(nil), time_key: T.unsafe(nil), need_process_info: T.unsafe(nil), log_host: T.unsafe(nil), **args); end

  # pkg:gem/semantic_logger#lib/semantic_logger/formatters/fluentd.rb:32
