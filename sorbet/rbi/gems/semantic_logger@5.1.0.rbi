# pkg:gem/semantic_logger#lib/semantic_logger/formatters/open_telemetry.rb:4
class SemanticLogger::Formatters::OpenTelemetry < ::SemanticLogger::Formatters::Raw
  # Returns the attributes hash submitted to the OpenTelemetry SDK.
