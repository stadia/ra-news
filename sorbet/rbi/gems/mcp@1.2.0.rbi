# pkg:gem/mcp#lib/mcp/client/http.rb:75
class MCP::Client::HTTP::InsecureURLError < ::ArgumentError; end

# pkg:gem/mcp#lib/mcp/client/http.rb:21
MCP::Client::HTTP::LAST_EVENT_ID_HEADER = T.let(T.unsafe(nil), String)

