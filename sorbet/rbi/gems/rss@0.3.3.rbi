# Provides a set of builders for various RSS objects
#
# * Feeds
#   * RSS 0.91
#   * RSS 1.0
#   * RSS 2.0
#   * Atom 1.0
#
# * Elements
#   * Atom::Entry
#
# pkg:gem/rss#lib/rss/maker.rb:18
module RSS::Maker
  class << self
    # Returns the maker for the +version+
    #
    # pkg:gem/rss#lib/rss/maker.rb:33
    def [](version); end

    # Adds a maker to the set of supported makers
    #
    # pkg:gem/rss#lib/rss/maker.rb:40
    def add_maker(version, normalized_version, maker); end

    # Builder for an RSS object
    # Creates an object of the type passed in +args+
    #
    # Executes the +block+ to populate elements of the created RSS object
    #
    # pkg:gem/rss#lib/rss/maker.rb:28
    def make(version, &block); end

    # Returns collection of supported makers
    #
    # pkg:gem/rss#lib/rss/maker.rb:50
    def makers; end

    # Returns true if the version is supported
    #
    # pkg:gem/rss#lib/rss/maker.rb:55
    def supported?(version); end

    # Returns collection of supported maker versions
    #
    # pkg:gem/rss#lib/rss/maker.rb:45
    def versions; end

    private

    # Can I remove this method?
    #
    # pkg:gem/rss#lib/rss/maker.rb:61
    def maker(version); end
  end
end

