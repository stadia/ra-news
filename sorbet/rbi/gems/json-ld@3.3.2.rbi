  def +(other); end

  # Validate extended RDF
  #
  # pkg:gem/json-ld#lib/json/ld/extensions.rb:30
  def valid_extended?; end
end

# pkg:gem/json-ld#lib/json/ld/extensions.rb:11
class RDF::Statement
  include ::RDF::Value
  include ::Comparable
  include ::RDF::Term

  # Validate extended RDF
  #
  # pkg:gem/json-ld#lib/json/ld/extensions.rb:13
  def valid_extended?; end
end

# pkg:gem/json-ld#lib/json/ld/extensions.rb:21
class RDF::URI
  include ::RDF::Value
  include ::Comparable
  include ::RDF::Term

  # Validate extended RDF
