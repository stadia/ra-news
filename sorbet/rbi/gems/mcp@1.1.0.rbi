# Reserved `_meta` keys for W3C Trace Context propagation, per SEP-414.
#
# The MCP spec reserves the un-prefixed `_meta` keys `traceparent`, `tracestate`, and `baggage`
# (an explicit exception to the reverse-DNS prefix rule for `_meta` keys) so that clients and
# servers can propagate distributed-tracing context across MCP requests.
# The SDK guarantees these keys pass through incoming request `_meta` untouched; tool, prompt,
# and resource handlers can read them from `server_context[:_meta]` and bridge them to a tracing
# system such as the `opentelemetry-ruby` gems. The SDK itself does not depend on OpenTelemetry.
#
# - https://github.com/modelcontextprotocol/modelcontextprotocol/pull/414
# - https://www.w3.org/TR/trace-context/
# - https://www.w3.org/TR/baggage/
#
# pkg:gem/mcp#lib/mcp/trace_context.rb:16
module MCP::TraceContext; end

# pkg:gem/mcp#lib/mcp/trace_context.rb:19
MCP::TraceContext::BAGGAGE_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/trace_context.rb:21
MCP::TraceContext::META_KEYS = T.let(T.unsafe(nil), Array)

# pkg:gem/mcp#lib/mcp/trace_context.rb:17
MCP::TraceContext::TRACEPARENT_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/trace_context.rb:18
MCP::TraceContext::TRACESTATE_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/transport.rb:6
class MCP::Transport
  # Initialize the transport with the server instance
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:8
  def initialize(server); end

  # Close the transport connection
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:24
  def close; end

  # Handle a JSON request
  # Returns a response that should be sent back to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:30
  def handle_json_request(request); end

  # Handle an incoming request
  # Returns a response that should be sent back to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:37
  def handle_request(request); end

  # Open the transport connection
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:19
  def open; end

  # Send a notification to the client.
  # Returns true if the notification was sent successfully.
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:44
  def send_notification(method, params = T.unsafe(nil)); end

  # Send a JSON-RPC request to the client and wait for a response.
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:49
  def send_request(method, params = T.unsafe(nil)); end

  # Send a response to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:14
  def send_response(response); end

  private

  # pkg:gem/mcp#lib/mcp/transport.rb:55
  def generate_request_id; end
end

