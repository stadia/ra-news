  def save_client_information(info); end

  # pkg:gem/mcp#lib/mcp/client/oauth/storage_backed_provider.rb:25
  def save_tokens(tokens); end

  # pkg:gem/mcp#lib/mcp/client/oauth/storage_backed_provider.rb:21
