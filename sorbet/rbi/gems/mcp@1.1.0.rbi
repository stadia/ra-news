  def notification?(body); end

  # pkg:gem/mcp#lib/mcp/server/transports/streamable_http_transport.rb:677
  def parse_accept_header(header); end

  # pkg:gem/mcp#lib/mcp/server/transports/streamable_http_transport.rb:727
