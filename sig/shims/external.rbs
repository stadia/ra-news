class MessageType
  def self.new: (Hash[untyped, untyped]) -> MessageType
  def to_proto: () -> String
end

# schema_dot_org defines `SchemaType` at the top level, not inside its own
# namespace. `NewsMediaOrganization` is app code and now generated from source.
class SchemaType
end

module SchemaDotOrg
  class Organization < SchemaType
  end
end

