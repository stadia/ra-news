# Phlex ships no RBS, so `Components::Base < Phlex::HTML` cannot be generated
# from source the way the rest of `sig/generated` is. Declare it bare, same as
# `Views::Base` above, so component signatures have a superclass to name.
module Components
  class Base
  end

  # Zeitwerk defines namespace modules implicitly from the directory layout, so
  # components written in compact form (`class Components::Layout::Foo`) have no
  # `module` keyword for rbs-inline to pick up. Declare them here, same as
  # `Views::Profiles` above.
  module Layout
  end
end

