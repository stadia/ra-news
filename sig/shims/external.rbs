module Madmin
  # `Madmin::ApplicationController` itself is app code (app/controllers/madmin)
  # and generated from source, so only its gem-side ancestors are shimmed here.
  # Real hierarchy: BaseController < ActionController::Base, ResourceController
  # < Madmin::ApplicationController.
  class BaseController < ActionController::Base
  end

  class ResourceController < Madmin::ApplicationController
  end
end

