# Generated from app/controllers/application_controller.rb with RBS::Inline

class ApplicationController < ActionController::Base
  include Authentication

  private

  # 익명 GET 요청에서 세션 쿠키를 억제하여 CDN 캐싱을 활성화한다.
  # 인증된 사용자는 개인화 응답이므로 캐싱에서 제외.
  # 댓글 폼 등 CSRF가 필요한 페이지(articles#show)는 호출하지 않는다.
  def cacheable_page!: (?max_age: untyped) -> untyped
end
