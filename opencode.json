{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "rails-ai-context": {
      "type": "local",
      "command": [
        "bundle",
        "exec",
        "rails",
        "ai:serve"
      ]
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}